# Reference values for the generated per-worktree environment. Normal local
# development uses `pnpm local:bootstrap` and `.dev/environment.env` instead.
APP_PORT=3000
DEV_POSTGRES_USER=codebuff
DEV_POSTGRES_PASSWORD=codebuff
DEV_POSTGRES_DB=codebuff_next
DEV_POSTGRES_PORT=5432

DEV_GARAGE_S3_PORT=3900
DEV_GARAGE_RPC_PORT=3901
DEV_GARAGE_WEB_PORT=3902

# Garage provisioning inputs. Keep these aligned with OBJECT_STORAGE_BUCKET,
# OBJECT_STORAGE_ACCESS_KEY_ID, and OBJECT_STORAGE_SECRET_ACCESS_KEY in
# .env.local. These fixed values are safe only for loopback-bound local use.
GARAGE_BOOTSTRAP_BUCKET=codebuff-next-article
GARAGE_BOOTSTRAP_ACCESS_KEY_ID=GK0123456789abcdef01234567
GARAGE_BOOTSTRAP_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# One-shot local administrator bootstrap.
AUTH_BOOTSTRAP_NAME=Codebuff Admin
AUTH_BOOTSTRAP_EMAIL=admin@codebuff.local
AUTH_BOOTSTRAP_PASSWORD=Local-Dev-Bootstrap-Password
