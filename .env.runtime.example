# Application runtime and host-side database tools.
# Copy this file to .env.local for local development.
PG_USER=codebuff
PG_PWD=codebuff
PG_DB=codebuff_next
PG_HOST=127.0.0.1
PG_PORT=5432
PG_POOL_MAX=5
PG_CONNECTION_TIMEOUT_MS=10000

# Next.js authentication runtime.
BETTER_AUTH_URL=http://localhost:3000
# WebAuthn relying party ID; keep this aligned with BETTER_AUTH_URL's hostname.
PASSKEY_RP_ID=localhost
# Replace with a real secret of at least 32 characters before using auth features.
BETTER_AUTH_SECRETS=0:replace-with-at-least-32-characters-secret

# Private application object storage. These fixed credentials match the
# loopback-only local Garage defaults in .env.dev.example. Production must
# inject a generated, least-privilege key scoped to its private bucket.
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:3900
OBJECT_STORAGE_REGION=garage
OBJECT_STORAGE_BUCKET=codebuff-next-article
OBJECT_STORAGE_ACCESS_KEY_ID=GK0123456789abcdef01234567
OBJECT_STORAGE_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
