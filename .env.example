# Host-side development. Compose overrides PG_HOST/PG_PORT for its containers.
PG_USER=codebuff
PG_PWD=codebuff
PG_DB=codebuff_next
PG_HOST=127.0.0.1
PG_PORT=5432
PG_POOL_MAX=5

# Next.js app
APP_PORT=3000
BETTER_AUTH_URL=http://localhost:3000
# Replace with a real secret of at least 32 characters before using auth features.
BETTER_AUTH_SECRETS=0:replace-with-at-least-32-characters-secret

# One-shot local account bootstrap
AUTH_BOOTSTRAP_NAME=Codebuff Admin
AUTH_BOOTSTRAP_EMAIL=admin@codebuff.local
AUTH_BOOTSTRAP_PASSWORD=Local-Dev-Bootstrap-Password

# Garage
GARAGE_S3_PORT=3900
GARAGE_RPC_PORT=3901
GARAGE_WEB_PORT=3902
