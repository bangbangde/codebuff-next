# syntax=docker/dockerfile:1@sha256:87999aa3d42bdc6bea60565083ee17e86d1f3339802f543c0d03998580f9cb89

FROM node:22-alpine@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2 AS base

FROM base AS package-manager
RUN apk add --no-cache libc6-compat
RUN corepack enable pnpm && corepack prepare pnpm@10.33.0 --activate

FROM package-manager AS deps
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,id=codebuff-pnpm-store,target=/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile --store-dir=/pnpm/store

FROM deps AS builder

COPY tsconfig.json tsconfig.migrate.json ./
COPY migrate ./migrate
COPY lib/db/config.ts ./lib/db/config.ts
COPY drizzle ./drizzle
COPY scripts/build-migration.mjs ./scripts/build-migration.mjs
RUN pnpm build:migrate

FROM deps AS production-deps
RUN --mount=type=cache,id=codebuff-pnpm-store,target=/pnpm/store,sharing=locked \
    CI=true pnpm --config.store-dir=/pnpm/store prune --prod

FROM package-manager AS development

WORKDIR /app

COPY --from=deps /app/node_modules /opt/codebuff/node_modules
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml /opt/codebuff/
COPY docker/dev-entrypoint.sh /usr/local/bin/dev-entrypoint.sh

ENTRYPOINT ["/bin/sh", "/usr/local/bin/dev-entrypoint.sh"]
CMD ["pnpm", "dev"]

# One-shot local initializer for database migrations, the development account,
# and no other service.
FROM node:22-alpine@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2 AS runner

WORKDIR /app

COPY --from=production-deps /app/node_modules ./node_modules
COPY --from=builder /app/.build/migrate ./.build/migrate
COPY scripts/bootstrap-auth-user.mjs ./scripts/bootstrap-auth-user.mjs

COPY <<'INIT_SCRIPT' /usr/local/bin/init.sh
#!/bin/sh
set -eu

echo "=== Applying PostgreSQL migrations ==="
node .build/migrate/migrate/index.js

echo "=== Bootstrapping the local authentication account ==="
node scripts/bootstrap-auth-user.mjs

echo "=== Local database initialization complete ==="
INIT_SCRIPT

RUN chmod +x /usr/local/bin/init.sh

USER node

ENTRYPOINT ["/bin/sh", "/usr/local/bin/init.sh"]
