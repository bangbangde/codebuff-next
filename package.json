{
  "name": "codebuff",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build && pnpm build:runtime-tools",
    "build:runtime-tools": "node scripts/build-runtime-tools.mjs",
    "auth:bootstrap": "node --env-file-if-exists=.env scripts/bootstrap-auth-user.mjs",
    "auth:schema": "auth generate --config ./lib/auth/schema-config.ts --output ./lib/db/schema/auth.generated.ts --adapter drizzle --dialect postgresql --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm build:runtime-tools && node --env-file-if-exists=.env .build/runtime-tools/db/migrate.cjs",
    "start": "next start",
    "lint": "eslint",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test \"test/*.test.mjs\"",
    "test:e2e:passkey": "node --env-file-if-exists=.env test/passkey-browser.e2e.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@better-auth/drizzle-adapter": "1.6.23",
    "@better-auth/passkey": "1.6.23",
    "better-auth": "1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.27.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "pg": "8.22.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.2.10",
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20",
    "@types/pg": "8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "auth": "1.6.23",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "playwright-core": "1.62.0",
    "shadcn": "^4.15.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
