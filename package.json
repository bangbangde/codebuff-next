{
  "name": "codebuff",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "next dev",
    "local:bootstrap": "node scripts/local/workspace.mjs bootstrap",
    "local:up": "node scripts/local/workspace.mjs up",
    "local:dev": "node scripts/local/workspace.mjs dev",
    "local:container:dev": "node scripts/local/workspace.mjs container-dev",
    "local:status": "node scripts/local/workspace.mjs status",
    "local:doctor": "node scripts/local/workspace.mjs doctor",
    "local:stop": "node scripts/local/workspace.mjs stop",
    "local:reset": "node scripts/local/workspace.mjs reset",
    "local:destroy": "node scripts/local/workspace.mjs destroy",
    "local:verify": "node scripts/local/workspace.mjs verify",
    "local:container:verify": "node scripts/local/workspace.mjs container-verify",
    "build": "next build && pnpm build:runtime-tools",
    "build:runtime-tools": "node scripts/build/runtime-tools.mjs",
    "auth:bootstrap": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.dev scripts/src/auth/bootstrap-user.mjs",
    "auth:schema": "auth generate --config ./lib/auth/schema-config.ts --output ./lib/db/schema/auth.generated.ts --adapter drizzle --dialect postgresql --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm build:runtime-tools && node --env-file-if-exists=.env.local .build/runtime-tools/db/migrate.cjs",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1097.0",
    "@base-ui/react": "^1.6.0",
    "@better-auth/drizzle-adapter": "1.6.23",
    "@better-auth/passkey": "1.6.23",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@uiw/react-codemirror": "^4.25.11",
    "better-auth": "1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "file-type": "^22.0.1",
    "lucide-react": "^1.27.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "pg": "8.22.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20",
    "@types/pg": "8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "auth": "1.6.23",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "shadcn": "^4.15.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
